# Point local Turbo at Informant's Linux/root backing directory to share cache artifacts with jobs.
# Copy this file to .env; Bun automatically loads it for `bun run` commands.
TURBO_CACHE_DIR=${HOME}/.local/share/informant/caches/linux/shared/f69aad2dcd2590c7

# Bound local Turborepo cache retention and disk usage.
TURBO_CACHE_MAX_AGE=14d
TURBO_CACHE_MAX_SIZE=10GB
