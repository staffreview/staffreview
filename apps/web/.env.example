# PostHog analytics (apps/web)
# Copy to `.env.local` and fill in to enable analytics. When unset, the client
# init and server capture are clean no-ops (analytics is simply disabled).

# Browser/client project token. NEXT_PUBLIC_* is inlined into the client bundle
# (required for posthog-js). Client events route through the `/ingest` reverse
# proxy defined in next.config.mjs.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Server-only overrides (optional). The server PostHog client uses these and
# falls back to the NEXT_PUBLIC_* token / the default ingest host if unset. Use
# these to keep a server token out of the client bundle.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
